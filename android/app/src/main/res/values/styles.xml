<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark like the app, whatever the phone's light/dark setting -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">#3B82F6</item>
    </style>

    <!-- The running app. Android 15 leaves strips for the system bars around the web view: they
         show this window background, so they match the app and the light status icons stay visible.
         The accent tints native pickers (a <select>'s list) in the app's default blue. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="colorAccent">#3B82F6</item>
    </style>


    <!-- Android 12+ draws its own launch screen from the windowSplashScreen* attributes, not from the splash image -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
