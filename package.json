{
  "name": "hoops-career",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hoops Career \u2014 a mobile-first basketball GM + head coach simulation with a deep tactics layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:fetch": "NODE_USE_ENV_PROXY=1 tsx scripts/data/fetch.ts",
    "data:build": "tsx scripts/data/build-seed.ts",
    "data:fetch-nba": "NODE_USE_ENV_PROXY=1 tsx scripts/data/nba/fetch.ts",
    "data:nba": "tsx scripts/data/nba/build.ts",
    "cap:sync": "npm run build && cap sync",
    "data": "npm run data:fetch && npm run data:fetch-nba && npm run data:build",
    "bench": "tsx scripts/engine-bench.ts",
    "season-test": "tsx scripts/season-test.ts",
    "real-check": "tsx scripts/real-check.ts",
    "smoke": "node scripts/qa/smoke.mjs",
    "invariants": "tsx scripts/league-invariants.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "comlink": "^4.4.2",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "cheerio": "^1.2.0",
    "hyparquet": "^1.31.3",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
